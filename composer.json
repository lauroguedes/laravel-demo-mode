{
    "name": "lauroguedes/laravel-demo-mode",
    "description": "Turn a Laravel installation into a public playground: seeded data, scheduled resets, rotating credentials, and a belt of restrictions that keeps a stranger from abusing the server.",
    "keywords": [
        "laravel",
        "demo",
        "demo-mode",
        "playground",
        "sandbox",
        "starter-kit"
    ],
    "homepage": "https://github.com/lauroguedes/laravel-demo-mode",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/lauroguedes/laravel-demo-mode/issues",
        "source": "https://github.com/lauroguedes/laravel-demo-mode",
        "docs": "https://github.com/lauroguedes/laravel-demo-mode/blob/main/docs/README.md",
        "security": "https://github.com/lauroguedes/laravel-demo-mode/security/policy"
    },
    "funding": [
        {
            "type": "custom",
            "url": "https://buymeacoffee.com/lauroguedes"
        }
    ],
    "authors": [
        {
            "name": "Lauro Guedes",
            "email": "laurowguedes@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/process": "^13.0",
        "illuminate/support": "^13.0",
        "symfony/process": "^7.4|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.2",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "rector/rector": "^2.6",
        "spatie/laravel-db-snapshots": "^2.10"
    },
    "suggest": {
        "spatie/laravel-db-snapshots": "Required for the snapshot reset strategy (^2.0)"
    },
    "autoload": {
        "psr-4": {
            "LauroGuedes\\DemoMode\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LauroGuedes\\DemoMode\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "lint": [
            "@php vendor/bin/pint --parallel",
            "@php vendor/bin/rector"
        ],
        "test:lint": [
            "@php vendor/bin/pint --parallel --test",
            "@php vendor/bin/rector --dry-run"
        ],
        "test:types": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "test:type-coverage": "@php vendor/bin/pest --type-coverage --min=100",
        "test:unit": "@php vendor/bin/pest",
        "test:coverage": "@php vendor/bin/pest --coverage",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ]
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LauroGuedes\\DemoMode\\DemoModeServiceProvider"
            ],
            "aliases": {
                "Demo": "LauroGuedes\\DemoMode\\Facades\\Demo"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
